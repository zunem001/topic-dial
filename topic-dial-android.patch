+    // Switching topics is one move, set so that its heavy part never runs while anything on screen is in motion: opening
+    // a topic (its messages loading, the list laying them out) holds up the frames for a moment, and anything moving
+    // then would stop and jump.
+    // 1. At once, the glass goes to the topic (TopicsTabsView) and the chat on screen lets go: it dims a little and
+    //    starts to slide away from the side the new topic is on. Nothing heavy runs, so both move freely.
+    // 2. Once the glass (or the wheel) has all but landed, the chat is caught in a picture, which holds still while the
+    //    topic opens behind it and the list takes its messages: whatever frames that takes, nothing on screen moves.
+    // 3. Then the picture slides on and fades, and the new messages glide in together from the side the topic is on
+    //    (across for a row of tabs, up or down for side tabs), crossing it. The chat is never blank.
+    // Every part keeps its own clock, a frame at a time and by no more than a frame and a half, so a frame held up anyway
+    // never makes it leap ahead. Picking more topics on the way opens only the last one; picking the topic on screen
+    // again before the other one opens brings the chat straight back.
+    private static final int SWITCH_IDLE = 0, SWITCH_LETTING_GO = 1, SWITCH_LOADING = 2, SWITCH_SETTLING = 3, SWITCH_ENTERING = 4, SWITCH_RETURNING = 5;
+    private int topicSwitchPhase = SWITCH_IDLE;
+    // Opens the topic picked last, once the glass has landed.
+    private Runnable topicSwitchOpen;
+    private long topicSwitchTarget, topicSwitchPickTime, topicSwitchFrame;
+    private float topicSwitchTime, topicSwitchFromAlpha, topicSwitchFromShift;
+    private int topicSwitchDirection, topicSwitchLeaveDirection, topicSwitchSettleFrames;
+    private boolean topicSwitchVertical;
+    private final Runnable topicSwitchGiveUp = this::onTopicSwitchLoaded;
+    private final Runnable topicSwitchTick = this::tickTopicSwitch;
+    // The picture of the chat being left, where the list is: still while the topic opens, then on its way out.
+    private Bitmap topicSwitchGhost;
+    private final Paint topicSwitchGhostPaint = new Paint(Paint.FILTER_BITMAP_FLAG);
+    private boolean topicSwitchGhostLeaving, topicSwitchGhostVertical;
+    private float topicSwitchGhostTime, topicSwitchGhostAlpha = 1f, topicSwitchGhostShift, topicSwitchGhostScale = 1f, topicSwitchGhostAway;
+
+    /** Starts a switch to target: the chat lets go now, and open runs once the glass has landed. */
+    private void beginTopicSwitch(long target, int direction, Runnable open) {
+        if (chatListView == null) {
+            open.run();
+            return;
+        }
+        topicSwitchTarget = target;
+        topicSwitchOpen = open;
+        topicSwitchPickTime = SystemClock.uptimeMillis();
+        topicSwitchDirection = direction;
+        AndroidUtilities.cancelRunOnUIThread(topicSwitchGiveUp);
+        if (topicSwitchPhase != SWITCH_LETTING_GO) {
+            // From wherever the chat is: it may be on its way in from the last switch, or still behind its picture.
+            topicSwitchVertical = topicsTabs != null && topicsTabs.getCurrentTabsPosition() == TopicsTabsView.Position.LEFT;
+            topicSwitchLeaveDirection = direction;
+            topicSwitchFromAlpha = chatListView.getAlpha();
+            topicSwitchFromShift = getTopicSwitchShift();
+            setTopicSwitchPhase(SWITCH_LETTING_GO);
+        }
+    }
+
+    /** Whether a switch is on its way to target, not yet opened. */
+    private boolean isTopicSwitchPending(long target) {
+        return topicSwitchOpen != null && topicSwitchTarget == target;
+    }
+
+    /** The topic on screen was picked again before the other one opened: the glass and the chat come back. */
+    private boolean returnFromTopicSwitch() {
+        if (topicSwitchOpen == null || chatListView == null) return false;
+        topicSwitchOpen = null;
+        if (topicsTabs != null) {
+            topicsTabs.setCurrentTopic(getTopicId());
+        }
+        topicSwitchFromAlpha = chatListView.getAlpha();
+        topicSwitchFromShift = getTopicSwitchShift();
+        setTopicSwitchPhase(SWITCH_RETURNING);
+        return true;
+    }
+
+    private void cancelTopicSwitch() {
+        topicSwitchOpen = null;
+        topicSwitchPhase = SWITCH_IDLE;
+        AndroidUtilities.cancelRunOnUIThread(topicSwitchGiveUp);
+        if (chatListView != null) {
+            chatListView.removeCallbacks(topicSwitchTick);
+        }
+        dropTopicSwitchGhost();
+    }
+
+    private void setTopicSwitchPhase(int phase) {
+        topicSwitchPhase = phase;
+        topicSwitchTime = 0f;
+        topicSwitchSettleFrames = 0;
+        postTopicSwitchTick();
+    }
+
+    private void postTopicSwitchTick() {
+        if (chatListView != null) {
+            chatListView.removeCallbacks(topicSwitchTick);
+            chatListView.postOnAnimation(topicSwitchTick);
+        }
+    }
+
+    // One frame of the switch: the chat, and its picture on the way out.
+    private void tickTopicSwitch() {
+        if (chatListView == null) return;
+        final long now = SystemClock.uptimeMillis();
+        final float dt = topicSwitchFrame == 0 || now - topicSwitchFrame > 500 ? 0f : Math.min(24, now - topicSwitchFrame) / 1000f;
+        topicSwitchFrame = now;
+        boolean more = false;
+        switch (topicSwitchPhase) {
+            case SWITCH_LETTING_GO: {
+                topicSwitchTime += dt;
+                final float e = CubicBezierInterpolator.EASE_OUT.getInterpolation(Math.min(1f, topicSwitchTime / 0.15f));
+                chatListView.setAlpha(topicSwitchFromAlpha * lerp(1f, 0.85f, e));
+                setTopicSwitchShift(lerp(topicSwitchFromShift, -topicSwitchLeaveDirection * dp(8), e));
+                if (topicsTabs == null || !topicsTabs.isGlassMoving() || now - topicSwitchPickTime > 500) {
+                    // The glass has all but landed (or it has been a while): the chat holds still in a picture, and the
+                    // topic opens behind it. Whatever frames that takes, nothing on screen is moving.
+                    catchTopicSwitchGhost();
+                    chatListView.setAlpha(0f);
+                    final Runnable open = topicSwitchOpen;
+                    topicSwitchOpen = null;
+                    topicSwitchPhase = SWITCH_LOADING;
+                    // A topic that takes long to load comes in anyway, after a while.
+                    AndroidUtilities.runOnUIThread(topicSwitchGiveUp, 1200);
+                    if (open != null) {
+                        open.run();
+                    }
+                } else {
+                    more = true;
+                }
+                break;
+            }
+            case SWITCH_SETTLING: {
+                // The messages are in the list, and the next frame lays them out; past it, the two cross.
+                if (++topicSwitchSettleFrames >= 2) {
+                    topicSwitchPhase = SWITCH_ENTERING;
+                    topicSwitchTime = 0f;
+                    setTopicSwitchShift(topicSwitchDirection * dp(36));
+                    startTopicSwitchGhostLeaving();
+                    if (topicsTabs != null) {
+                        topicsTabs.onTopicOpened();
+                    }
+                }
+                more = true;
+                break;
+            }
+            case SWITCH_ENTERING: {
+                // The picture gets a head start of a couple of frames, so the two cross rather than stack.
+                topicSwitchTime += dt;
+                final float q = Utilities.clamp((topicSwitchTime - 0.04f) / 0.38f, 1f, 0f);
+                setTopicSwitchShift(topicSwitchDirection * dp(36) * (1f - CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(q)));
+                chatListView.setAlpha(CubicBezierInterpolator.EASE_OUT.getInterpolation(Math.min(1f, q / 0.5f)));
+                if (q >= 1f) {
+                    topicSwitchPhase = SWITCH_IDLE;
+                } else {
+                    more = true;
+                }
+                break;
+            }
+            case SWITCH_RETURNING: {
+                topicSwitchTime += dt;
+                final float e = CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(Math.min(1f, topicSwitchTime / 0.3f));
+                chatListView.setAlpha(lerp(topicSwitchFromAlpha, 1f, e));
+                setTopicSwitchShift(lerp(topicSwitchFromShift, 0, e));
+                if (e >= 1f) {
+                    topicSwitchPhase = SWITCH_IDLE;
+                    if (topicsTabs != null) {
+                        topicsTabs.onTopicOpened();
+                    }
+                } else {
+                    more = true;
+                }
+                break;
+            }
+        }
+        // The picture on its way out slides on and recedes a little as it fades.
+        if (topicSwitchGhost != null) {
+            if (topicSwitchGhostLeaving) {
+                topicSwitchGhostTime += dt;
+                final float p = Math.min(1f, topicSwitchGhostTime / 0.2f), t = CubicBezierInterpolator.EASE_OUT.getInterpolation(p);
+                topicSwitchGhostShift = topicSwitchGhostAway * t;
+                topicSwitchGhostScale = 1f - 0.03f * t;
+                topicSwitchGhostAlpha = 1f - t;
+                if (p >= 1f) {
+                    dropTopicSwitchGhost();
+                } else {
+                    more = true;
+                }
+            }
+            if (contentView != null) {
+                contentView.invalidate();
+            }
+        }
+        if (more) {
+            chatListView.postOnAnimation(topicSwitchTick);
+        }
+    }
+
+    /** The new topic's messages are in the list (or it gave up waiting for them): once they are laid out, they come in. */
+    private void onTopicSwitchLoaded() {
+        AndroidUtilities.cancelRunOnUIThread(topicSwitchGiveUp);
+        if (topicSwitchPhase != SWITCH_LOADING || chatListView == null) return;
+        setTopicSwitchPhase(SWITCH_SETTLING);
+    }
+
+    // What the chat shows now (the list as it is, over a picture still on its way out) in one picture the size of the
+    // list, in the list's own coordinates. A fresh picture each time: the last one may still be on its way to the screen.
+    private void catchTopicSwitchGhost() {
+        final int width = chatListView.getWidth(), height = chatListView.getHeight();
+        if (width <= 0 || height <= 0) {
+            dropTopicSwitchGhost();
+            return;
+        }
+        final Bitmap bitmap;
+        try {
+            bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+            final Canvas canvas = new Canvas(bitmap);
+            final float scale = Math.max(0.01f, chatListView.getScaleX());
+            final Bitmap leaving = topicSwitchGhost;
+            if (leaving != null && topicSwitchGhostAlpha > 0f) {
+                canvas.save();
+                canvas.translate((topicSwitchGhostVertical ? 0 : topicSwitchGhostShift) / scale, (topicSwitchGhostVertical ? topicSwitchGhostShift : 0) / scale);
+                canvas.scale(topicSwitchGhostScale, topicSwitchGhostScale, width / 2f, height / 2f);
+                topicSwitchGhostPaint.setAlpha((int) (0xFF * topicSwitchGhostAlpha));
+                canvas.drawBitmap(leaving, 0, 0, topicSwitchGhostPaint);
+                canvas.restore();
+            }
+            final float alpha = chatListView.getAlpha();
+            if (alpha > 0f) {
+                final int count = canvas.save();
+                canvas.translate(chatListView.getTranslationX() / scale, chatListView.getTranslationY() / scale);
+                if (alpha < 1f) {
+                    canvas.saveLayerAlpha(0, 0, width, height, (int) (0xFF * alpha));
+                }
+                chatListView.draw(canvas);
+                canvas.restoreToCount(count);
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+            dropTopicSwitchGhost();
+            return;
+        }
+        topicSwitchGhost = bitmap;
+        topicSwitchGhostLeaving = false;
+        topicSwitchGhostVertical = topicSwitchVertical;
+        topicSwitchGhostAlpha = 1f;
+        topicSwitchGhostShift = 0;
+        topicSwitchGhostScale = 1f;
+        if (contentView != null) {
+            contentView.invalidate();
+        }
+    }
+
+    private void startTopicSwitchGhostLeaving() {
+        if (topicSwitchGhost == null || topicSwitchGhostLeaving) return;
+        topicSwitchGhostLeaving = true;
+        topicSwitchGhostTime = 0f;
+        topicSwitchGhostAway = -topicSwitchLeaveDirection * dp(12);
+    }
+
+    private void dropTopicSwitchGhost() {
+        // Not recycled: the last frame that showed it may still be on its way to the screen.
+        topicSwitchGhost = null;
+        topicSwitchGhostLeaving = false;
+        topicSwitchGhostAlpha = 1f;
+        if (contentView != null) {
+            contentView.invalidate();
+        }
+    }
+
+    // The picture of the chat being left, where the list is, stepping aside with it when side tabs are out over the chat.
+    private void drawTopicSwitchGhost(Canvas canvas) {
+        final Bitmap ghost = topicSwitchGhost;
+        if (ghost == null || topicSwitchGhostAlpha <= 0f || chatListView == null) return;
+        canvas.save();
+        canvas.translate(
+            chatListView.getLeft() + (topicSwitchGhostVertical ? 0 : topicSwitchGhostShift),
+            chatListView.getTop() + (topicSwitchGhostVertical ? topicSwitchGhostShift : 0)
+        );
+        canvas.scale(chatListView.getScaleX(), chatListView.getScaleY(), chatListView.getPivotX(), chatListView.getPivotY());
+        canvas.scale(topicSwitchGhostScale, topicSwitchGhostScale, ghost.getWidth() / 2f, ghost.getHeight() / 2f);
+        topicSwitchGhostPaint.setAlpha((int) (0xFF * topicSwitchGhostAlpha));
+        canvas.drawBitmap(ghost, 0, 0, topicSwitchGhostPaint);
+        canvas.restore();
+    }
+
+    private float getTopicSwitchShift() {
+        return topicSwitchVertical ? chatListView.getTranslationY() : chatListView.getTranslationX();
+    }
+
+    private void setTopicSwitchShift(float shift) {
+        chatListView.setTranslationX(topicSwitchVertical ? 0 : shift);
+        chatListView.setTranslationY(topicSwitchVertical ? shift : 0);
+    }
