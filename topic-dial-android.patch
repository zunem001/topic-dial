+        lastTick = index;
+        if (edge) {
+            AndroidUtilities.vibrate(this);
+        } else {
+            AndroidUtilities.vibrateCursor(this);
+        }
+        if (delegate != null) {
+            delegate.onWheelScrub(index);
+        }
+    }
