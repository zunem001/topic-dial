+    // While side tabs are rolled out over the chat, the conversation steps aside for them: back and to
+    // the right about its bottom right corner, until its bubbles (about 50 dp in, after the avatars)
+    // clear the rail with 6 dp to spare, while the avatars tuck into the bubbles as the rail's edge
+    // passes them (see getAvatarTuck). It moves with the rail and comes back as the rail winds up; the
+    // newest message stays where it is, just above the input, and nothing is cut off.
+    private void checkUi_chatAside() {
+        if (chatListView == null) return;
+        final float railOverChat = topicsTabs != null ? topicsTabs.getRailOverChat() : 0f;
+        if (railOverChat > 0f || lastRailOverChat > 0f) {
+            chatListView.invalidate();
+        }
+        lastRailOverChat = railOverChat;
+        final float aside = topicsTabs != null ? topicsTabs.getChatAside() : 0f;
+        final float width = chatListView.getWidth();
+        if (width <= dp(SIDE_MENU_WIDTH + 6)) return;
+        final float scale = AndroidUtilities.lerp(1f, (width - dp(SIDE_MENU_WIDTH + 6)) / (width - dp(50)), aside);
+        if (chatListView.getScaleX() == scale) return;
+        chatListView.setPivotX(width);
+        chatListView.setPivotY(chatListView.getHeight() - chatListView.getPaddingBottom());
+        chatListView.setScaleX(scale);
+        chatListView.setScaleY(scale);
+    }
+
+    private final int[] avatarTuckLocation = new int[2];
+    private float lastRailOverChat;
+
+    // How far a message's avatar, centred at height y in the chat list, tucks into its bubble: all the
+    // way with side tabs open, as Telegram does, and under a rail rolled out over the chat as the rail's
+    // edge passes it, so none peeks out from under the rail.
+    private float getAvatarTuck(float y) {
+        final float sideMenu = getSideMenuAlpha();
+        if (topicsTabs == null || chatListView == null || topicsTabs.getRailOverChat() <= 0f) {
+            return sideMenu;
+        }
+        chatListView.getLocationInWindow(avatarTuckLocation);
+        final float listTop = avatarTuckLocation[1];
+        topicsTabs.getLocationInWindow(avatarTuckLocation);
+        return Math.max(sideMenu, topicsTabs.getAvatarTuck(listTop + y * chatListView.getScaleY() - avatarTuckLocation[1]));
+    }
+
