+    private static let topicsRolledUpByDefaultKey = "TopicsRollRolledUpByDefault"
+    
+    /// The topic bar's roll: each group keeps its own choice, and your latest choice is the default for forum groups
+    /// where you have not chosen yet.
+    private var topicsRollState: ChatTopicsRollState {
+        let isRolledUp = self.chatPresentationInterfaceState.persistentData.topicListRolledUp ?? (UserDefaults.standard.object(forKey: ChatControllerNode.topicsRolledUpByDefaultKey) as? Bool ?? true)
+        return ChatTopicsRollState(isRolledUp: isRolledUp, isTemporarilyOut: isRolledUp && self.topicsRollTemporarilyOut)
+    }
+    
+    private var topicsRollActions: ChatTopicsRollActions {
+        if let current = self.topicsRollActionsValue {
+            return current
+        }
+        let actions = ChatTopicsRollActions(
+            rollOut: { [weak self] in
+                self?.updateTopicsRollTemporarilyOut(true)
+            },
+            windUp: { [weak self] in
+                guard let self else {
+                    return
+                }
+                if self.topicsRollTemporarilyOut {
+                    self.updateTopicsRollTemporarilyOut(false)
+                } else if !self.topicsRollState.isRolledUp {
+                    self.setTopicsRolledUp(true)
+                }
+            },
+            keepOpen: { [weak self] in
+                self?.setTopicsRolledUp(false)
+            }
+        )
+        self.topicsRollActionsValue = actions
+        return actions
+    }
+    
+    private func updateTopicsRollTemporarilyOut(_ isOut: Bool) {
+        if self.topicsRollTemporarilyOut == isOut {
+            return
+        }
+        self.topicsRollTemporarilyOut = isOut
+        // Rolling out takes 0.54 s with a soft landing; winding up takes 0.48 s.
+        self.requestLayout(.animated(duration: isOut ? 0.54 : 0.48, curve: .spring))
+    }
+    
+    private func setTopicsRolledUp(_ isRolledUp: Bool) {
+        self.topicsRollTemporarilyOut = false
+        UserDefaults.standard.set(isRolledUp, forKey: ChatControllerNode.topicsRolledUpByDefaultKey)
+        self.controller?.updateChatPresentationInterfaceState(animated: true, interactive: true, { state in
+            var persistentData = state.persistentData
+            persistentData.topicListRolledUp = isRolledUp
+            return state.updatedPersistentData(persistentData)
+        })
+    }
